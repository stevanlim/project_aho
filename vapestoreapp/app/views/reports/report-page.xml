<Page xmlns="http://schemas.nativescript.org/tns.xsd"
  navigatingTo="onNavigatingTo"
  actionBarHidden="true"
  class="bg-slate-950">

  <ScrollView>
    <StackLayout class="p-4">
      <!-- 1. Header with Straight Centered Refresh Button -->
      <GridLayout columns="*, auto" class="mb-3" rows="auto">
        <StackLayout col="0">
          <Label text="{{ pageTitle }}" class="text-xl font-bold text-primary" />
          <Label text="{{ pageSubtitle }}" class="text-xs text-secondary mt-0.5" />
          <Label text="{{ userName + (isKasir ? ' • Kasir' : ' • Administrator') }}"
            class="text-xs text-cyan font-bold mt-1" style="color: #00f0ff;" />
        </StackLayout>

        <!-- Centered Refresh Button (Lurus & Presisi) -->
        <GridLayout col="1" tap="onRefresh" rows="*" columns="*"
          style="width: 40; height: 38; background-color: #1e293b; border-radius: 12; border-width: 1; border-color: #334155;"
          verticalAlignment="center">
          <Label row="0" col="0" text="⟲" horizontalAlignment="center" verticalAlignment="center" textAlignment="center"
            style="font-size: 18; font-weight: 900; color: #f8fafc;" />
        </GridLayout>
      </GridLayout>

      <!-- 2. Period Filter Pills (Hari Ini, Bulan Ini, Tahun Ini, Kustom) -->
      <ScrollView orientation="horizontal" scrollBarIndicatorVisible="false" class="mb-3">
        <StackLayout orientation="horizontal">
          <Label text="Hari Ini" tap="onFilterToday"
            class="{{ selectedPeriod === 'today' ? 'pill active' : 'pill' }}" />
          <Label text="Bulan Ini" tap="onFilterMonth"
            class="{{ selectedPeriod === 'month' ? 'pill active' : 'pill' }}" />
          <Label text="Tahun Ini" tap="onFilterYear"
            class="{{ selectedPeriod === 'year' ? 'pill active' : 'pill' }}" />
          <Label text="Kustom Tanggal" tap="onFilterCustom"
            class="{{ selectedPeriod === 'custom' ? 'pill active' : 'pill' }}" />
        </StackLayout>
      </ScrollView>

      <!-- 3. Custom Date Range Filter Box (Hanya muncul jika Kustom dipilih) -->
      <StackLayout class="card p-3 mb-3" visibility="{{ isCustomPeriod ? 'visible' : 'collapsed' }}"
        style="background-color: #0b1120; border-width: 1.5; border-color: #00f0ff; border-radius: 14;">
        <Label text="PILIH RENTANG TANGGAL (YYYY-MM-DD)" class="text-xxs font-bold text-cyan mb-2" style="color: #00f0ff;" />
        
        <GridLayout columns="*, *" class="mb-2" rows="auto">
          <StackLayout col="0" class="mr-1">
            <Label text="Dari Tanggal:" class="text-xxs text-secondary mb-1" />
            <TextField text="{{ startDate }}" hint="YYYY-MM-DD" class="input-dark"
              style="height: 38; font-size: 12; padding: 4 8; border-radius: 8;" />
          </StackLayout>

          <StackLayout col="1" class="ml-1">
            <Label text="Sampai Tanggal:" class="text-xxs text-secondary mb-1" />
            <TextField text="{{ endDate }}" hint="YYYY-MM-DD" class="input-dark"
              style="height: 38; font-size: 12; padding: 4 8; border-radius: 8;" />
          </StackLayout>
        </GridLayout>

        <!-- Button Terapkan Filter with Neon Stroke -->
        <Button text="Terapkan Filter Tanggal" tap="onApplyCustomFilter" class="btn btn-block"
          style="background-color: rgba(0, 240, 255, 0.12); border-width: 1.5; border-color: #00f0ff; color: #00f0ff; font-size: 12; font-weight: 800; border-radius: 10; padding: 8;" />
      </StackLayout>

      <!-- Loading Indicator -->
      <ActivityIndicator busy="{{ isLoading }}" visibility="{{ isLoading ? 'visible' : 'collapsed' }}" class="mb-3" />

      <!-- 4. Hero Card: Total Pendapatan Sesuai Filter -->
      <StackLayout class="mb-3"
        style="background-color: #032b1f; border-width: 2; border-color: #00ff87; border-radius: 18; padding: 18;">
        <GridLayout columns="auto, *" class="mb-1">
          <Label col="0" text="Rp"
            style="font-size: 14; font-weight: 900; color: #00ff87; background-color: rgba(0, 255, 135, 0.15); border-radius: 8; padding: 2 6;" />
          <Label col="1" text="{{ 'TOTAL PENDAPATAN ' + periodLabel }}"
            style="color: #6ee7b7; font-size: 11; font-weight: 800; text-align: right;" />
        </GridLayout>

        <Label text="{{ periodRevenue }}"
          style="color: #ffffff; font-size: 28; font-weight: 900; margin-top: 4; margin-bottom: 4;" textWrap="true" />

        <GridLayout columns="auto, *" class="mt-1">
          <Label col="0" text="Total Transaksi:" style="color: #a7f3d0; font-size: 13; font-weight: 700;" />
          <Label col="1" text="{{ periodSalesCount + ' Transaksi' }}"
            style="color: #ffffff; font-size: 13; font-weight: 800; text-align: right;" />
        </GridLayout>
      </StackLayout>

      <!-- 5. Breakdown Metode Pembayaran (Cash, QRIS, Transfer) -->
      <Label text="{{ 'Rincian Pembayaran (' + periodLabel + ')' }}" class="text-xs font-bold text-secondary mb-2 ml-1" />
      
      <GridLayout columns="*, *, *" rows="auto" class="mb-4">
        <!-- Cash / Tunai Card -->
        <StackLayout col="0" class="card-sm p-3 mr-1"
          style="background-color: #0d1527; border-width: 1.5; border-color: #00ff87; border-radius: 14;">
          <Label text="TUNAI" style="font-size: 10; font-weight: 900; color: #00ff87;" />
          <Label text="{{ cashRevenue }}" style="font-size: 13; font-weight: 800; color: #ffffff; margin-top: 4;" textWrap="true" />
          <Label text="{{ cashCount }}" class="text-xxs text-secondary mt-1" />
        </StackLayout>

        <!-- QRIS Card -->
        <StackLayout col="1" class="card-sm p-3 mx-1"
          style="background-color: #0d1527; border-width: 1.5; border-color: #00f0ff; border-radius: 14;">
          <Label text="QRIS" style="font-size: 10; font-weight: 900; color: #00f0ff;" />
          <Label text="{{ qrisRevenue }}" style="font-size: 13; font-weight: 800; color: #ffffff; margin-top: 4;" textWrap="true" />
          <Label text="{{ qrisCount }}" class="text-xxs text-secondary mt-1" />
        </StackLayout>

        <!-- Transfer Card -->
        <StackLayout col="2" class="card-sm p-3 ml-1"
          style="background-color: #0d1527; border-width: 1.5; border-color: #fbbf24; border-radius: 14;">
          <Label text="TRANSFER" style="font-size: 10; font-weight: 900; color: #fbbf24;" />
          <Label text="{{ transferRevenue }}" style="font-size: 13; font-weight: 800; color: #ffffff; margin-top: 4;" textWrap="true" />
          <Label text="{{ transferCount }}" class="text-xxs text-secondary mt-1" />
        </StackLayout>
      </GridLayout>

      <!-- 6. ADMIN VIEW: Ringkasan Toko & Inventori -->
      <StackLayout visibility="{{ isAdmin ? 'visible' : 'collapsed' }}">
        <Label text="Inventori &amp; Ringkasan Toko" class="text-xs font-bold text-secondary mb-2 ml-1" />

        <!-- Row 1: Produk & Stok Rendah -->
        <GridLayout columns="*, *" rows="auto" class="mb-3">
          <StackLayout col="0" class="stat-card" style="margin-right: 4;">
            <Label text="KATALOG" style="font-size: 9; font-weight: 800; color: #94a3b8;" />
            <Label text="{{ totalProducts }}" class="text-2xl font-extrabold text-primary my-1" />
            <Label text="Produk Terdaftar" class="text-xxs text-muted" />
          </StackLayout>

          <StackLayout col="1" class="stat-card" style="margin-left: 4;">
            <Label text="STOK MENIPIS" style="font-size: 9; font-weight: 800; color: #fbbf24;" />
            <Label text="{{ lowStockCount }}" class="text-2xl font-extrabold text-amber my-1" />
            <Label text="Peringatan (&lt;= 5)" class="text-xxs text-amber" />
          </StackLayout>
        </GridLayout>

        <!-- Row 2: Stok Habis & Akumulasi Bulan Ini -->
        <GridLayout columns="*, *" rows="auto" class="mb-4">
          <StackLayout col="0" class="stat-card" style="margin-right: 4;">
            <Label text="STOK HABIS" style="font-size: 9; font-weight: 800; color: #f43f5e;" />
            <Label text="{{ outOfStockCount }}" class="text-2xl font-extrabold text-rose my-1" />
            <Label text="Stok Kosong (0)" class="text-xxs text-rose" />
          </StackLayout>

          <StackLayout col="1" class="stat-card" style="margin-left: 4;">
            <Label text="AKUMULASI BULAN INI" style="font-size: 9; font-weight: 800; color: #00f0ff;" />
            <Label text="{{ monthRevenue }}" class="text-base font-extrabold text-cyan my-1" style="color: #00f0ff;" textWrap="true" />
            <Label text="{{ monthSalesCount + ' Transaksi' }}" class="text-xxs text-muted" />
          </StackLayout>
        </GridLayout>
      </StackLayout>

      <!-- 7. Action Button: Perbarui Data Laporan dengan Stroke Neon -->
      <Button text="Perbarui Data Laporan" tap="onRefresh" class="btn btn-block mb-3"
        style="background-color: rgba(0, 240, 255, 0.08); border-width: 1.5; border-color: #00f0ff; color: #00f0ff; font-size: 14; font-weight: 800; border-radius: 12; padding: 13;" />

      <!-- Kasir Logout (Hanya Kasir) -->
      <Button text="Keluar Akun Kasir" tap="onLogout" class="btn btn-rose btn-block mb-4"
        visibility="{{ isKasir ? 'visible' : 'collapsed' }}"
        style="background-color: rgba(244, 63, 94, 0.12); border-width: 1.5; border-color: #f43f5e; color: #ff4d6d; font-weight: 800; border-radius: 12;" />

    </StackLayout>
  </ScrollView>
</Page>
