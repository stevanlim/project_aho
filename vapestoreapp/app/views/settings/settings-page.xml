<Page xmlns="http://schemas.nativescript.org/tns.xsd"
  navigatingTo="onNavigatingTo"
  class="bg-slate-950">

  <ActionBar title="Pengaturan Toko" class="bg-slate-900">
    <NavigationButton text="" tap="onGoBack" android.systemIcon="ic_menu_back" />
  </ActionBar>

  <ScrollView>
    <StackLayout class="p-4">
      <Label text="{{ errorMessage }}" visibility="{{ errorMessage ? 'visible' : 'collapsed' }}"
        class="text-rose text-sm p-3 bg-rose-dim rounded mb-3" textWrap="true" />

      <ActivityIndicator busy="{{ isLoading }}" visibility="{{ isLoading ? 'visible' : 'collapsed' }}" />

      <StackLayout visibility="{{ !isLoading ? 'visible' : 'collapsed' }}">
        <!-- Store Name -->
        <Label text="Nama Toko" class="text-xs font-bold text-secondary mb-1" />
        <TextField text="{{ storeName }}" class="input-dark mb-3" />

        <!-- Address -->
        <Label text="Alamat Toko" class="text-xs font-bold text-secondary mb-1" />
        <TextView text="{{ address }}" class="input-dark mb-3" style="height: 60;" />

        <!-- Phone -->
        <Label text="Nomor Telepon" class="text-xs font-bold text-secondary mb-1" />
        <TextField text="{{ phone }}" keyboardType="phone" class="input-dark mb-3" />

        <!-- Invoice Footer -->
        <Label text="Catatan Kaki Struk" class="text-xs font-bold text-secondary mb-1" />
        <TextView text="{{ invoiceFooter }}" class="input-dark mb-3" style="height: 60;" />

        <!-- Low Stock Threshold -->
        <Label text="Batas Peringatan Stok Rendah" class="text-xs font-bold text-secondary mb-1" />
        <TextField text="{{ lowStockThreshold }}" keyboardType="number" class="input-dark mb-4" />

        <!-- Save -->
        <Button text="{{ isSaving ? 'Menyimpan...' : 'SIMPAN PENGATURAN' }}"
          tap="onSave" isEnabled="{{ !isSaving }}"
          class="btn btn-emerald btn-block btn-lg" style="font-weight: 700;" />
      </StackLayout>
    </StackLayout>
  </ScrollView>
</Page>
